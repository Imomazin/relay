# Relay — environment variables
# Copy this file to .env.local (Next.js) or .env (scripts) and fill in real values.
# NEVER commit a real DATABASE_URL or any credential. This repository is PUBLIC.

# Neon PostgreSQL pooled connection string (serverless driver friendly).
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require"

# Optional: seed determinism control (integer). Default is 20240521.
# RELAY_SEED=20240521
